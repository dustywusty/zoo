#!/bin/sh
# zoo-setup: run once, as root, while zoo builds a cage image from your own
# image (zoo.yaml image: or dockerfile:). Gives it what every cage needs:
#
#   - bash, git, socat, ca-certificates and curl (apt-get or apk images)
#   - the unprivileged "agent" user with your uid/gid (AGENT_UID/AGENT_GID),
#     home /home/agent. A user that already has that uid (node, uid 1000, on
#     Linux) is removed first; its home directory stays.
#   - /etc/zoo/masked and /run/zoo, used by zoo-init
#
# Agent CLIs (claude, codex, ...) are yours to install in your image.
set -eu

die() {
  echo "zoo: $*" >&2
  exit 1
}

uid=${AGENT_UID:-}
gid=${AGENT_GID:-}
case "$uid$gid" in
  '' | *[!0-9]*) die "AGENT_UID and AGENT_GID must be numbers" ;;
esac
[ "$uid" -ne 0 ] || die "the agent can't be root: run zoo as an ordinary user"

# 1. Packages.
if command -v apt-get >/dev/null 2>&1; then
  export DEBIAN_FRONTEND=noninteractive
  apt-get update
  apt-get install -y --no-install-recommends bash ca-certificates curl git socat
  rm -rf /var/lib/apt/lists/*
elif command -v apk >/dev/null 2>&1; then
  apk add --no-cache bash ca-certificates curl git socat
else
  echo "zoo: no apt-get or apk in this image; using the tools it already has" >&2
fi
command -v bash >/dev/null 2>&1 || die "this image has no bash and no apt-get or apk to install it; zoo's session wrapper needs bash"
for t in git socat; do
  command -v "$t" >/dev/null 2>&1 || echo "zoo: warning: no $t in this image (git: agents can't commit; socat: no ssh-agent grants)" >&2
done

# 2. The agent user.
if command -v useradd >/dev/null 2>&1; then
  flavor=shadow
elif command -v adduser >/dev/null 2>&1 && adduser 2>&1 | grep -q -- '-D'; then
  flavor=busybox
else
  die "this image has neither useradd (Debian, Ubuntu, Fedora) nor busybox adduser (Alpine); zoo can't create the agent user. Install one (e.g. the shadow or passwd package) in your Dockerfile"
fi

remove_user() {
  if [ "$flavor" = shadow ]; then userdel "$1"; else deluser "$1"; fi
}

# Whoever holds the uid, or the name "agent", gives them up.
holder=$(getent passwd "$uid" 2>/dev/null | cut -d: -f1 || true)
if [ -z "$holder" ]; then
  holder=$(awk -F: -v u="$uid" '$3 == u { print $1; exit }' /etc/passwd)
fi
if [ -n "$holder" ] && [ "$holder" != agent ]; then
  echo "zoo: removing user $holder (uid $uid) to give the agent your uid" >&2
  remove_user "$holder"
fi
if grep -q '^agent:' /etc/passwd; then
  if [ "$(id -u agent)" != "$uid" ]; then
    remove_user agent
  fi
fi

# Reuse a group that already has the gid (20 is "dialout" on Debian and
# Alpine); otherwise create "agent".
group=$(getent group "$gid" 2>/dev/null | cut -d: -f1 || true)
if [ -z "$group" ]; then
  group=$(awk -F: -v g="$gid" '$3 == g { print $1; exit }' /etc/group)
fi
if [ -z "$group" ]; then
  group=agent
  if grep -q '^agent:' /etc/group; then
    group=zoo-agent
  fi
  if [ "$flavor" = shadow ]; then groupadd -g "$gid" "$group"; else addgroup -g "$gid" "$group"; fi
fi

if ! grep -q '^agent:' /etc/passwd; then
  mkdir -p /home
  if [ "$flavor" = shadow ]; then
    useradd -m -d /home/agent -u "$uid" -g "$gid" -s /bin/bash agent
  else
    adduser -D -h /home/agent -u "$uid" -G "$group" -s /bin/bash agent
  fi
fi
mkdir -p /home/agent
chown -R "$uid:$gid" /home/agent

# 3. zoo's own files.
mkdir -p /etc/zoo /run/zoo
: > /etc/zoo/masked
chmod 0444 /etc/zoo/masked
chmod 0755 /usr/local/bin/zoo-init /usr/local/bin/zoo-doctor /usr/local/bin/zoo-session
rm -f /usr/local/bin/zoo-setup

# Skip Claude Code's first-run onboarding, as the default cage does.
if [ ! -e /home/agent/.claude.json ]; then
  printf '{"hasCompletedOnboarding":true,"autoUpdates":false}\n' > /home/agent/.claude.json
  chown "$uid:$gid" /home/agent/.claude.json
fi
